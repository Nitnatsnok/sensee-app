{
  "mcpServers": {
    "graphify": {
      "command": "uv",
      "args": ["run", "--with", "graphifyy[mcp]", "python", "-m", "graphify.serve", "graphify-out/graph.json"]
    },
    "likec4": {
      "command": "npx",
      "args": ["-y", "@likec4/mcp"],
      "env": {
        "LIKEC4_WORKSPACE": "docs/c4"
      }
    }
  }
}
