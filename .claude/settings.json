{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./secrets.properties)",
      "Read(./*.jks)",
      "Read(./**/*.jks)",
      "Read(./*.keystore)",
      "Read(./**/*.keystore)",
      "Read(./local.properties)"
    ]
  }
}
