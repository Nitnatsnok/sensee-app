root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# Windows script files must stay CRLF.
[{*.bat,*.cmd}]
end_of_line = crlf

[{*.json,*.jsonc,*.md,*.yaml,*.yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{*.kt,*.kts}]
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ktlint_function_naming_ignore_when_annotated_with = Composable
# ktlint's filename rule is PascalCase-opinionated and over-reaches on idiomatic
# single-function/entrypoint files (main.kt, createX.kt, rememberX.kt) and KMP
# target-suffixed files. The meaningful "single top-level classifier must match
# the filename" check is owned by detekt's MatchingDeclarationName, so this rule
# is disabled to avoid the duplicate and a growing filename-glob denylist.
ktlint_standard_filename = disabled
