-- Library owns deck structure only; sense content lives in the canonical `sense`
-- store (lexicon). A membership row references a `sense_id` (no cross-module FK),
-- so a Service deck mirrors senses by id and the captured deck is derived from
-- Personal Confirmed senses — neither duplicates the sense blob here.
CREATE TABLE deck (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    -- 0 = passive synced Service-catalog cache; 1 = the user subscribed, so the
    -- deck's senses are mirrored into the material they practice (successor of
    -- the old adopted_at flag).
    subscribed INTEGER NOT NULL DEFAULT 0,
    -- Advertised card count from the catalog source. Authoritative for display: a
    -- Service deck has no local membership until subscribed, so a join COUNT would
    -- read 0 in the suggestions list.
    card_count INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE deck_membership (
    deck_id TEXT NOT NULL,
    sense_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    PRIMARY KEY (deck_id, sense_id),
    FOREIGN KEY (deck_id) REFERENCES deck(id)
);

CREATE INDEX deck_membership_deck_id ON deck_membership(deck_id);

CREATE INDEX deck_membership_sense_id ON deck_membership(sense_id);

selectAllDecks:
SELECT id, title, description, subscribed, card_count
FROM deck
ORDER BY title ASC;

selectSubscribedDecks:
SELECT id, title, description, subscribed, card_count
FROM deck
WHERE subscribed != 0
ORDER BY title ASC;

selectDeckById:
SELECT id, title, description, subscribed, card_count
FROM deck
WHERE id = ?;

selectMembershipByDeck:
SELECT sense_id, position
FROM deck_membership
WHERE deck_id = ?
ORDER BY position ASC;

-- Two-statement upsert (sqlite_3_18 has no ON CONFLICT DO UPDATE): INSERT OR
-- IGNORE leaves an existing row (and its subscribed flag) untouched, then the
-- metadata UPDATE refreshes title/description/count only. INSERT OR REPLACE would
-- delete+reinsert the row and wipe `subscribed` on every Service re-sync.
insertDeckIfAbsent:
INSERT OR IGNORE INTO deck(id, title, description, card_count)
VALUES (?, ?, ?, ?);

updateDeckMeta:
UPDATE deck
SET title = ?, description = ?, card_count = ?
WHERE id = ?;

setDeckSubscribed:
UPDATE deck
SET subscribed = ?
WHERE id = ?;

clearDeckMembership:
DELETE FROM deck_membership
WHERE deck_id = ?;

insertDeckMembership:
INSERT OR REPLACE INTO deck_membership(deck_id, sense_id, position)
VALUES (?, ?, ?);
