CREATE TABLE lexical_entry (
    id TEXT NOT NULL PRIMARY KEY,
    term TEXT NOT NULL,
    status TEXT NOT NULL,
    meanings_json TEXT NOT NULL DEFAULT '[]',
    updated_at_epoch_ms INTEGER NOT NULL
);

CREATE INDEX lexical_entry_status ON lexical_entry(status);

selectAllEntries:
SELECT *
FROM lexical_entry
ORDER BY updated_at_epoch_ms ASC;

selectEntry:
SELECT *
FROM lexical_entry
WHERE id = ?;

upsertEntry:
INSERT OR REPLACE INTO lexical_entry(id, term, status, meanings_json, updated_at_epoch_ms)
VALUES (?, ?, ?, ?, ?);

deleteEntry:
DELETE FROM lexical_entry
WHERE id = ?;
