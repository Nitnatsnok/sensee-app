CREATE TABLE user_setting (
    scope TEXT NOT NULL,
    category TEXT NOT NULL,
    key TEXT NOT NULL,
    value_json TEXT NOT NULL,
    updated_at_epoch_ms INTEGER NOT NULL,
    schema_version INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (scope, category, key)
);

CREATE INDEX user_setting_scope_category ON user_setting(scope, category);

selectSettingsByScope:
SELECT *
FROM user_setting
WHERE scope = ?
ORDER BY category ASC, key ASC;

upsertSetting:
INSERT OR REPLACE INTO user_setting(
    scope,
    category,
    key,
    value_json,
    updated_at_epoch_ms,
    schema_version
)
VALUES (?, ?, ?, ?, ?, ?);

deleteSetting:
DELETE FROM user_setting
WHERE scope = ? AND category = ? AND key = ?;
