model {
  learner = actor 'Пользователь' {
    description 'Основной актор клиентских приложений Sensee и текущего реализованного учебного среза.'
    link ../arc42/sections/03_context_and_scope.adoc
  }

  // External systems

  platform_services = external_system 'Platform Services' {
    description 'Жизненный цикл, ресурсы, настройки, управление окнами, SQL-драйверы и прочие платформенные возможности.'
    technology 'OS / Runtime Services'
    link ../arc42/sections/03_context_and_scope.adoc
  }

  provider_apis = external_system 'External Provider APIs' {
    description 'OpenAI-compatible LLM APIs, ElevenLabs/OpenAI TTS APIs, Free Dictionary, Datamuse, LanguageTool и другие provider endpoints, доступные только через клиентские seams.'
    technology 'External provider APIs'
    link ../arc42/sections/03_context_and_scope.adoc
  }

  future_backend = external_system 'Future Sensee Backend' {
    #future
    description 'Отложенный внешний backend для синхронизации, контента, профиля и общего серверного поведения.'
    technology 'Ktor Server API'
    link ../arc42/sections/03_context_and_scope.adoc
  }

  // Sensee client system

  client = client_app 'Sensee Client Applications' {
    description 'KMP-клиент с общим app shell, реализованными practice/library/profile/capture срезами и набором shared-библиотек для дальнейшего роста продукта.'
    technology 'Kotlin Multiplatform + Compose Multiplatform'
    icon tech:kotlin
    link ../README.md

    // Shell
    shell = container 'App Shell' {
      description 'Общая тема, root composition, platform environments и навигационная оболочка.'
      technology 'shared/app-shell'
      link ../arc42/sections/05_building_block_view.adoc

      root = component 'Root & DI' {
        description 'RootComponent, Metro `AppGraph`, `createAppRoot(...)`: связывает навигацию, DI-биндинги и shared-зависимости.'
        technology 'shared/app-shell + Metro AppGraph'
        link ../arc42/sections/08_concepts.adoc
      }

      primary_navigation = component 'Primary Navigation' {
        description 'PrimaryShellComponent и config-driven переходы между пятью постоянными разделами.'
        technology 'PrimaryShellComponent'
        link ../arc42/sections/06_runtime_view.adoc
      }

      splash = component 'Startup Splash' {
        description 'Cold-start splash: держится ровно пока идёт `PreloadAppStartupUseCase` для runtime-таксономии. При сбое показывает retryable state; при тёплом восстановлении персистентного root-стека минуется — deep-target возвращается без splash.'
        technology 'StartupComponent + shared/feature/startup'
        link ../arc42/sections/06_runtime_view.adoc
      }
    }

    // Feature: Home
    feature_home = container 'Home Feature' {
      description 'Стартовый раздел Home.'
      technology 'shared/feature/home'
      link ../arc42/sections/06_runtime_view.adoc

      home = component 'Home Section' {
        description 'Дашборд-агрегатор: реализован виджет «Стоит повторить» (due-счётчик + дневная цель, CTA в due-сессию); не владеет доменом, уводит в другие разделы через NavigationDispatcher. Планируемые блоки: незавершённый capture, быстрый ввод.'
        technology 'HomeSectionComponent'
      }
    }

    // Feature: Practice
    feature_practice = container 'Practice Feature' {
      description 'Раздел Practice — потребитель курируемых колод; владелец review-сценария.'
      technology 'shared/feature/practice'
      link ../arc42/sections/06_runtime_view.adoc

      practice_ui = component 'Practice Section' {
        description 'PracticeSectionComponent: реализованы PracticeHome, DeckPractice flow и CardDetail (two-pane). Карта остаётся лёгкой (recognition). Планируемое расширение detail-панели — полный хаб исследования и отдельный экран настроек practice.'
        technology 'shared/feature/practice/presentation/{api,impl}'
      }

      practice_domain = component 'Practice Domain' {
        description 'PracticeSessionPolicy, PracticeCardFront, CardReview и PracticeReviewRepository: feature-owned граница review-сценария.'
        technology 'shared/feature/practice/domain'
        link ../arc42/sections/08_concepts.adoc
      }

      practice_data = component 'Practice Data' {
        description 'DefaultPracticeReviewRepository, SRS storage/mappers и review-log integration для practice flow.'
        technology 'shared/feature/practice/data'
      }

      practice_schema = store 'Practice Schema' {
        description 'SQLDelight-схема карточек, grammar tags и SRS-состояния, принадлежащая practice feature.'
        technology 'shared/feature/practice/database-schema'
        icon tech:sqlite
      }
    }

    // Feature: Library
    feature_library = container 'Library Feature' {
      description 'Раздел Library — владелец каталога. Practice — read-only потребитель курируемых колод.'
      technology 'shared/feature/library'
      link ../arc42/sections/06_runtime_view.adoc

      library_ui = component 'Library Section' {
        description 'LibrarySectionComponent. Реализовано: Home (отфильтрованный каталог собственного материала + подписка на сервисный набор целиком, обратимо), read-only DeckDetail (просмотр карточек собственного и сервисного набора без записи через previewDeck; общий design-system SenseeSenseCard; явное добавление сервисного набора с экрана). Список и DeckDetail — адаптивный двухпанельный list-detail (Decompose ChildPanels + AppChildPanels, режим от contentPresentation, как Profile). Планируется: третья панель деталей карточки, курирование колод (many-to-many), LemmaDetail, правка/удаление, claim части набора.'
        technology 'shared/feature/library/presentation/{api,impl}'
      }

      library_catalog = component 'Library Catalog' {
        description 'CatalogRepository, CatalogAdoptionRepository, ClaimRepository, SenseCatalogProjection и fixture-backed service-set loading.'
        technology 'shared/feature/library/{domain,data}'
        link ../arc42/sections/08_concepts.adoc
      }

      card_derivation = capability 'Card Derivation' {
        description 'Реализованная projection-логика `SenseCatalogProjection`: Confirmed Personal смыслы проецируются в captured deck как одна карточка на `sense_id` и группируются по `lemma_key`. Form-card схема id `sense_id:form:slot` зарезервирована, но сами form cards больше не автогенерируются из `irregularForms`; это planned явный выбор при добавлении.'
        technology 'shared/feature/library/data'
        link ../domain/information-model.adoc
      }

      library_schema = store 'Library Schema' {
        description 'Feature-owned SQLDelight schema для `deck`/`deck_membership` (флаг `subscribed` на `deck`; membership по `sense_id`, без контента смысла).'
        technology 'shared/feature/library/database-schema'
        icon tech:sqlite
      }

      service_catalog = component 'Service Sets Catalog' {
        #future
        description 'Планируемые сервисные наборы (curated sets), приходящие через backend-compatible boundary; добавляются в собственный каталог пользователя целиком или частично.'
        technology 'future service catalog'
        link ../arc42/sections/08_concepts.adoc
      }
    }

    // Feature: Vocabulary Editor
    feature_vocabulary = container 'Vocabulary Editor Feature' {
      description 'Раздел Vocabulary Editor — host реализованного add-path и подготовленного write workflow.'
      technology 'shared/feature/vocabulary-editor'
      link ../arc42/sections/06_runtime_view.adoc

      vocabulary_ui = component 'Vocabulary Editor Section' {
        description 'VocabularyEditorSectionComponent с реализованным add-path: `QuickCapture` создаёт смыслы через AI enrichment и пишет их через `SenseWriteRepository`. UI edit-surface и deep-link в редактор (EB-7) остаются planned.'
        technology 'shared/feature/vocabulary-editor/presentation/{api,impl}'
      }

      vocabulary_capture = capability 'Vocabulary Capture' {
        description 'Реализованный primary product capability (ADR-001): ввод → verifier даёт pre-AI grounding в prompt → AI/curated enrichment → набор `Sense` → silent post-AI фильтр качества примеров (не опустошает список) → мультивыбор + ручной смысл (опц. «дополнить ассистентом») → подтверждение. Поток одностраничный, выбор и есть подтверждение. Verification подключён к живому capture в двух узких ролях; обе деградируют штатно.'
        technology 'vocabulary authoring flow'
        link ../arc42/sections/06_runtime_view.adoc
      }

      vocabulary_domain = component 'Vocabulary Domain' {
        description '`SuggestVocabularySensesUseCase` (enrich-only) и две роли verification (pre-AI grounding / post-AI example-quality); editor-state `CaptureSense` живёт в `presentation/api`. Запись подтверждённых смыслов идёт через `SenseWriteRepository` (`lexicon`).'
        technology 'shared/feature/vocabulary-editor/domain'
        link ../domain/information-model.adoc
      }
    }

    // Feature: Profile
    feature_profile = container 'Profile Feature' {
      description 'Раздел Profile — владелец пользовательских настроек.'
      technology 'shared/feature/profile'
      link ../arc42/sections/06_runtime_view.adoc

      profile_ui = component 'Profile Section' {
        description 'ProfileSectionComponent. Реализовано: категории `Ai`, `Learning` и `App` (`themeMode`) над `UserSettingsRepository`; `ProfileAiSettingsLogic` (верификация ключа, выбор модели/голоса). Планируется: `Practice`, `Experimental`, `About`, Account/синхронизация и статистика. Scope по умолчанию `Device`.'
        technology 'shared/feature/profile/presentation/{api,impl}'
      }
    }

    // Lexicon (canonical sense store)
    lexicon = container 'Lexicon' {
      description 'Нейтральная каноническая лексическая модель, её единственный durable-store и сериализация.'
      technology 'shared/lexicon'
      link ../domain/information-model.adoc

      lexical_model = component 'Sense Source Model' {
        description 'Центральный `Sense` (+`ContextualApplication`/`AlignmentChunk`/`WordFamilyMember`), read model `StoredSense`, `SenseId`, `WriteIntent`, раздельные `SenseReadRepository`/`SenseWriteRepository`/`SearchPort`/`LexicalGraphReader`/`EmbeddingPort` (+`SenseQuery`/`LexicalEdge`/`EmbeddingVector`/`SimilarSense`) и `CefrLevel`.'
        technology 'shared/lexicon/domain'
      }

      sense_serialization = component 'Sense Serialization' {
        description 'Общий `SenseDto` (`Sense` ⇄ JSON) — сериализованная форма канона для персиста и сервис-wire.'
        technology 'shared/lexicon/serialization'
      }

      lexical_data = component 'Sense Store' {
        description 'Единственный durable-store `Sense`: `DefaultSenseRepository` (read/write контракты) + `DefaultSenseSearch` (in-memory `SearchPort`, отдельный класс) + `DefaultLexicalGraphReader` (derive-on-read граф) + `DefaultEmbeddingPort` (similar-sense: `sense_embedding`, brute-force cosine, отдельный класс), `DefaultSenseIdFactory` (Personal `Uuid` / Service `svc-`+FNV-1a), origin-scoped `resolveOrMint`, id-preserving правка.'
        technology 'shared/lexicon/data'
      }

      lexical_schema = store 'Sense Schema' {
        description 'Seam-owned SQLDelight schema: каноническая таблица `sense` (CHECK/partial unique index по `source_ref`) + `sense_embedding` (нормализованный float32-вектор смысла, навесное).'
        technology 'shared/lexicon/database-schema'
        icon tech:sqlite
      }
    }

    // Grammar taxonomy
    grammar = container 'Grammar Taxonomy' {
      description 'Нейтральная грамматическая таксономия, не привязанная к конкретному AI-провайдеру.'
      technology 'shared/grammar'
      link ../domain/pos-and-forms.adoc

      grammar_taxonomy = component 'Grammar Taxonomy' {
        description 'Нейтральные `GrammarUnitType`, `GrammarTag`, `GrammarCategory/Form`, runtime labels/invariants providers и fixtures поверх `CachingGrammarTaxonomyProvider`.'
        technology 'shared/grammar/{domain,data}'
      }
    }

    // User settings
    settings = container 'User Settings' {
      description 'Домен и хранилище пользовательских настроек.'
      technology 'shared/settings'
      link ../arc42/sections/08_concepts.adoc

      settings_domain = component 'Settings Domain' {
        description 'Типизированные категории пользовательских настроек и `UserSettingsRepository` contract.'
        technology 'shared/settings/domain'
      }

      settings_data = component 'Settings Data' {
        description '`DefaultUserSettingsRepository`, local data source и `LegacyAiSecretsMigration` (миграция секретов в secure storage).'
        technology 'shared/settings/data'
      }

      settings_schema = store 'Settings Schema' {
        description 'SQLDelight-схема `user_setting` для shared пользовательских настроек.'
        technology 'shared/settings/database-schema'
        icon tech:sqlite
      }
    }

    // AI enrichment seam
    ai = container 'AI Enrichment Seam' {
      description 'Provider-agnostic boundary contract, settings-backed routing и anti-corruption mapping (ADR-005).'
      technology 'shared/ai'
      link ../adr/0005-ai-enrichment-seam-is-an-explicit-boundary-contract.adoc

      ai_seam = component 'AI Enrichment Boundary' {
        description 'Граница `core` + композиция `integration`: маршрутизация curated→LLM, anti-corruption mapping в `Sense`.'
        technology 'shared/ai/{core,integration}'
      }

      ai_curated = component 'Curated Adapter' {
        description 'Курированный enrichment с бэкенда: вручную подготовленное покрытие частых phrasal verbs и idioms; на hit полностью обходит LLM, без пользовательского ключа.'
        technology 'shared/ai/curated-enrichment'
      }

      ai_llm = component 'LLM Adapter' {
        description 'OpenAI-compatible LLM adapter и model catalog, когда настройки дают валидный provider/key.'
        technology 'shared/ai/llm'
      }

      ai_embedding = component 'AI Embedding Boundary' {
        description 'Второй контракт того же шва — embedding: `AiEmbeddingClient` (`core`), `LlmAiEmbeddingClient` (`llm`, OpenAI `/v1/embeddings`, degrade→null), биндинг в `integration` (реюз ключа/базового URL провайдера). Идёт отдельным путём, вектор не на enrichment-wire (ADR-006).'
        technology 'shared/ai/{core,llm,integration}'
      }
    }

    // TTS seam
    tts = container 'TTS Seam' {
      description 'Speech contract, playback/cache и provider-specific адаптеры.'
      technology 'shared/tts'
      link ../arc42/sections/05_building_block_view.adoc

      tts_seam = component 'TTS Boundary' {
        description 'Граница `core` + композиция `integration`: routing, settings-backed selection.'
        technology 'shared/tts/{core,integration}'
      }

      tts_providers = component 'TTS Providers' {
        description 'Provider-specific адаптеры для System, ElevenLabs и OpenAI TTS.'
        technology 'shared/tts/{system,elevenlabs,openai}'
      }

      tts_playback = component 'Playback & Cache' {
        description 'Воспроизведение синтезированной речи и кэш аудио.'
        technology 'shared/tts/{playback,cache}'
      }

      tts_schema = store 'TTS Schema' {
        description 'Seam-owned SQLDelight schema для кэша TTS.'
        technology 'shared/tts/database-schema'
        icon tech:sqlite
      }
    }

    // Lexical verification seam
    verification = container 'Lexical Verification Seam' {
      description 'Лексическая верификация с лицензионным барьером (ADR-007).'
      technology 'shared/verification'
      link ../adr/0007-lexical-verification-seam-with-license-aware-aggregator.adoc

      verification_seam = component 'Verification Boundary' {
        description 'License-aware aggregator: граница `core` + композиция `integration`, двухуровневый кэш (L1 + L2, ADR-009). Подключён к живому capture в двух узких ролях: pre-AI grounding в prompt (фильтр по `usableAsLlmContext`) и post-AI silent example-quality (не опустошает список примеров).'
        technology 'shared/verification/{core,integration}'
      }

      verification_curated = component 'Curated Reference' {
        description 'Backend-served curated reference (sensee-curated по HTTP).'
        technology 'shared/verification/sensee-curated'
      }

      verification_network = component 'Network Adapters' {
        description 'Free Dictionary, Datamuse и LanguageTool — сетевые адаптеры под query policy.'
        technology 'shared/verification/{free-dictionary,datamuse,languagetool}'
      }

      verification_schema = store 'Verification Schema' {
        description 'Seam-owned SQLDelight schema для license-gated L2 cache.'
        technology 'shared/verification/database-schema'
        icon tech:sqlite
      }
    }

    // SRS engine
    srs = container 'SRS Engine' {
      description 'Cross-platform SRS model, engine и FSRS implementation, используемые practice data flow для review scheduling.'
      technology 'shared/srs'
      link ../arc42/sections/05_building_block_view.adoc

      srs_engine = component 'SRS Engine' {
        description 'SRS model/engine и FSRS scheduler (ADR-004).'
        technology 'shared/srs/{core,engine,fsrs,fsrs-engine}'
      }
    }

    // UI libraries
    ui = container 'UI Libraries' {
      description 'Переиспользуемые UI-библиотеки.'
      technology 'shared/ui'
      link ../arc42/sections/05_building_block_view.adoc

      design_system = component 'Design System' {
        description 'Токены, тема и базовые компоненты — единый источник UI-стиля и семантики.'
        technology 'shared/ui/design-system'
      }

      adaptive = component 'Adaptive UI' {
        description 'Адаптивная раскладка под разные форм-факторы.'
        technology 'shared/ui/adaptive'
      }

      learning_deck = component 'Learning Deck' {
        description 'Reusable swipeable card deck с flip, keyboard support, programmatic swipe и undo.'
        technology 'shared/ui/learning-deck'
      }

      sense_card = component 'Sense Card' {
        description 'Общая богатая карточка смысла: проецирует Sense (+ GrammarLabels) в нейтральную оболочку SenseeSenseCard. Единственный domain-aware UI-модуль; используется захватом и Library.'
        technology 'shared/ui/sense-card'
      }
    }

    // Core runtime & foundations
    core = container 'Core Runtime' {
      description 'Navigation, compose runtime, network/transport, observability и secure storage.'
      technology 'shared/core'
      link ../arc42/sections/08_concepts.adoc

      core_runtime = component 'Navigation & Compose Runtime' {
        description 'Decompose navigation, component context, compose runtime и platform abstractions.'
        technology 'shared/core/{decompose,compose,platform}'
      }

      core_presentation = component 'Presentation Utilities' {
        description 'Общие presentation-состояния и утилиты, например `DataLoadingState`.'
        technology 'shared/core/presentation'
      }

      network = component 'Network Foundation' {
        description 'Multiplatform network boundary на Ktor; предоставляет `HttpClient` через DI.'
        technology 'shared/core/network'
      }

      mock_backend = component 'Mock Backend' {
        description 'Fixture-backed Ktor `MockEngine` и fixture aggregation для текущего учебного client flow без live backend.'
        technology 'shared/core/mock-backend'
      }

      observability = component 'Observability' {
        description 'Runtime diagnostics boundary: logging, crash reporting, analytics и tracing contracts с no-op/local/platform defaults; внешние telemetry backends ещё планируются.'
        technology 'shared/core/{observability,tracing}'
      }

      secure_storage = store 'Secure Storage' {
        description 'Per-platform OS vault (iOS Keychain, Android Keystore-backed storage, desktop/web) для AI/TTS API-ключей; legacy-ключи мигрируются сюда. Граница безопасности.'
        technology 'shared/core/secure-storage'
        link ../adr/0005-ai-enrichment-seam-is-an-explicit-boundary-contract.adoc
      }
    }

    // Persistence (aggregate database)
    persistence = store 'Persistence' {
      description 'SQLDelight runtime, database provider и platform drivers. Агрегирует feature- и seam-owned schema в единый `SenseeDatabase`.'
      technology 'shared/database'
      icon tech:sqlite
      link ../arc42/sections/07_deployment_view.adoc
    }

    // Relationships

    // Shell wiring
    shell.root -[depends]-> core.core_runtime 'creates root component graph'
    shell.root -[depends]-> core.observability 'wires diagnostics boundary'
    shell.root -[depends]-> persistence 'wires shared persistence'
    shell.root -[depends]-> settings.settings_data 'wires settings repository'
    shell.root -[depends]-> ai.ai_seam 'wires AI enrichment seam'
    shell.root -[depends]-> verification.verification_seam 'wires verification seam'
    shell.root -[depends]-> tts.tts_seam 'wires speech services'
    shell.root -[depends]-> grammar.grammar_taxonomy 'preloads runtime taxonomy'
    shell.splash -[depends]-> grammar.grammar_taxonomy 'awaits PreloadAppStartupUseCase'
    shell.splash -[navigates]-> shell.primary_navigation 'StartupState.Loaded opens shell'
    shell.root -[navigates]-> shell.primary_navigation 'hosts primary navigation'

    // Primary navigation to section targets
    shell.primary_navigation -[navigates]-> feature_home.home 'persistent root target'
    shell.primary_navigation -[navigates]-> feature_practice.practice_ui 'persistent root target'
    shell.primary_navigation -[navigates]-> feature_vocabulary.vocabulary_ui 'persistent root target (add-path)'
    shell.primary_navigation -[navigates]-> feature_library.library_ui 'persistent root target'
    shell.primary_navigation -[navigates]-> feature_profile.profile_ui 'persistent root target'

    // Practice
    feature_practice.practice_ui -[depends]-> ui.learning_deck 'renders reusable deck UI'
    feature_practice.practice_ui -[depends]-> core.core_presentation 'uses DataLoadingState'
    feature_practice.practice_ui -[depends]-> core.observability 'reports presentation failures'
    feature_practice.practice_ui -[flows]-> tts.tts_seam 'speaks card text via Speaker'
    feature_practice.practice_ui -[flows]-> feature_library.library_catalog 'loads deck via CatalogRepository'
    feature_practice.practice_ui -[flows]-> feature_practice.practice_domain 'submits review via PracticeReviewRepository'
    feature_practice.practice_data -[depends]-> feature_practice.practice_domain 'implements review repository'
    feature_practice.practice_data -[depends]-> feature_practice.practice_schema 'owns practice tables'
    feature_practice.practice_data -[depends]-> srs.srs_engine 'updates review state'
    feature_practice.practice_data -[depends]-> grammar.grammar_taxonomy 'uses grammar taxonomy'
    feature_practice.practice_data -[flows]-> persistence 'stores review state' { technology 'SQLDelight' }

    // Library
    feature_library.library_ui -[flows]-> feature_library.library_catalog 'reads own material + adoption state'
    feature_library.library_catalog -[flows]-> core.network 'loads fixture-backed catalog/decks' { technology 'Ktor client' }
    feature_library.library_catalog -[flows]-> core.mock_backend 'contributes catalog fixtures'
    feature_library.library_catalog -[flows]-> lexicon.lexical_model 'reads/writes senses via Sense*Repository'
    feature_library.library_catalog -[depends]-> lexicon.sense_serialization 'maps the service SenseDto wire to Sense'
    feature_library.library_catalog -[depends]-> srs.srs_engine 'copies SRS snapshot during claim only'
    feature_library.library_catalog -[flows]-> persistence 'stores deck/membership state' { technology 'SQLDelight' }
    feature_library.library_catalog -[depends]-> feature_library.library_schema 'owns deck tables'
    lexicon.lexical_model -[flows]-> feature_library.card_derivation 'projects confirmed senses into captured cards'
    feature_library.card_derivation -[flows]-> feature_library.library_catalog 'captured deck enters catalog projection'
    feature_library.library_ui -[navigates]-> feature_library.service_catalog 'browses service sets' { #future }
    feature_library.service_catalog -[flows]-> future_backend 'fetches curated sets' { #future; technology 'API' }
    feature_library.service_catalog -[flows]-> feature_library.library_catalog 'adopted fully or partially' { #future }

    // Vocabulary capture / editing
    feature_vocabulary.vocabulary_ui -[flows]-> verification.verification_seam 'grounding before AI, example-quality after AI'
    feature_vocabulary.vocabulary_ui -[flows]-> ai.ai_seam 'requests candidate enrichment'
    feature_vocabulary.vocabulary_domain -[depends]-> lexicon.lexical_model 'maps AI response into Sense (domain mapper)'
    feature_vocabulary.vocabulary_ui -[flows]-> feature_vocabulary.vocabulary_capture 'selection = confirmation'
    feature_vocabulary.vocabulary_ui -[depends]-> feature_vocabulary.vocabulary_domain 'uses SuggestVocabularySensesUseCase'
    feature_vocabulary.vocabulary_capture -[flows]-> lexicon.lexical_data 'persists confirmed senses via SenseWriteRepository'
    feature_vocabulary.vocabulary_capture -[depends]-> grammar.grammar_taxonomy 'uses neutral grammar cues'

    // Lexicon (canonical sense store)
    lexicon.lexical_data -[depends]-> lexicon.lexical_model 'implements Sense read/write repositories'
    lexicon.lexical_data -[depends]-> lexicon.lexical_schema 'owns sense table'
    lexicon.lexical_data -[flows]-> persistence 'stores senses' { technology 'SQLDelight' }
    lexicon.lexical_data -[flows]-> ai.ai_embedding 'embeds confirmed senses on save (best-effort)'

    // Profile
    feature_profile.profile_ui -[flows]-> settings.settings_domain 'edits user settings'
    feature_profile.profile_ui -[flows]-> ai.ai_seam 'verifies AI key and models'
    feature_profile.profile_ui -[flows]-> tts.tts_seam 'verifies TTS key and voices'

    // Settings
    settings.settings_data -[depends]-> settings.settings_domain 'implements UserSettingsRepository'
    settings.settings_data -[flows]-> persistence 'stores user settings' { technology 'SQLDelight' }
    settings.settings_data -[flows]-> core.secure_storage 'persists provider API keys'

    // AI seam
    ai.ai_seam -[flows]-> ai.ai_curated 'serves curated hits first'
    ai.ai_seam -[flows]-> ai.ai_llm 'routes to configured LLM on miss'
    ai.ai_seam -[depends]-> settings.settings_domain 'reads AI settings'
    ai.ai_curated -[flows]-> core.mock_backend 'fetches curated enrichment fixtures' { technology 'Ktor client' }
    ai.ai_llm -[flows]-> provider_apis 'calls compatible model APIs' { technology 'HTTPS' }
    ai.ai_embedding -[depends]-> settings.settings_domain 'reuses provider key/base URL'
    ai.ai_embedding -[flows]-> provider_apis 'calls embedding API' { technology 'HTTPS' }

    // TTS seam
    tts.tts_seam -[flows]-> tts.tts_providers 'routes to selected provider'
    tts.tts_seam -[depends]-> tts.tts_playback 'plays back and caches speech'
    tts.tts_seam -[depends]-> settings.settings_domain 'reads speech settings'
    tts.tts_playback -[depends]-> tts.tts_schema 'owns tts cache tables'
    tts.tts_playback -[flows]-> persistence 'reads/writes audio cache' { technology 'SQLDelight' }
    tts.tts_providers -[flows]-> provider_apis 'calls speech provider APIs' { technology 'HTTPS' }

    // Verification seam
    verification.verification_seam -[flows]-> verification.verification_curated 'license-gated curated reference first'
    verification.verification_seam -[flows]-> verification.verification_network 'network adapters under query policy'
    verification.verification_seam -[depends]-> verification.verification_schema 'owns L2 cache tables'
    verification.verification_seam -[flows]-> persistence 'writes license-gated L2 cache' { technology 'SQLDelight' }
    verification.verification_curated -[flows]-> core.network 'fetches sensee-curated over HTTP' { technology 'Ktor client' }
    verification.verification_network -[flows]-> provider_apis 'calls verification provider APIs' { technology 'HTTPS' }

    // Core foundations
    core.mock_backend -[depends]-> core.network 'provides MockEngine to HttpClient' { technology 'Ktor MockEngine' }

    // UI foundation (design system / adaptive layout used across shell and feature UIs)
    shell.root -[depends]-> ui.design_system 'builds on shared design system'
    shell.root -[depends]-> ui.adaptive 'uses adaptive layout'
    feature_home.home -[depends]-> ui.design_system 'renders with design system'
    feature_practice.practice_ui -[depends]-> ui.design_system 'renders with design system'
    feature_practice.practice_ui -[depends]-> ui.adaptive 'uses adaptive layout'
    feature_library.library_ui -[depends]-> ui.design_system 'renders with design system'
    feature_library.library_ui -[depends]-> ui.adaptive 'uses adaptive list-detail layout'
    feature_vocabulary.vocabulary_ui -[depends]-> ui.design_system 'renders with design system'
    feature_profile.profile_ui -[depends]-> ui.design_system 'renders with design system'
    feature_profile.profile_ui -[depends]-> ui.adaptive 'uses adaptive layout'

    // Shared rich sense card (capture + Library) over the neutral design-system shell
    feature_vocabulary.vocabulary_ui -[depends]-> ui.sense_card 'renders a sense via the shared sense card'
    feature_library.library_ui -[depends]-> ui.sense_card 'renders a sense via the shared sense card'
    ui.sense_card -[depends]-> ui.design_system 'targets the neutral SenseeSenseCard shell'
    ui.sense_card -[depends]-> lexicon.lexical_model 'maps the Sense domain model'
    ui.sense_card -[depends]-> grammar.grammar_taxonomy 'resolves grammar labels for badges'

    // Persistence aggregation (shared/database collects feature/seam schema)
    persistence -[depends]-> feature_practice.practice_schema 'aggregates feature schema'
    persistence -[depends]-> feature_library.library_schema 'aggregates feature schema'
    persistence -[depends]-> lexicon.lexical_schema 'aggregates seam schema'
    persistence -[depends]-> settings.settings_schema 'aggregates settings schema'
    persistence -[depends]-> tts.tts_schema 'aggregates seam schema'
    persistence -[depends]-> verification.verification_schema 'aggregates seam schema'
    persistence -[flows]-> platform_services 'uses platform SQL drivers' { technology 'Platform APIs' }

    // Cross-feature navigation (planned/future)
    feature_practice.practice_ui -[navigates]-> feature_vocabulary.vocabulary_ui 'opens entry editing from a card' { #prepared }
    feature_library.library_ui -[navigates]-> feature_vocabulary.vocabulary_ui 'edits an entry from a card' { #prepared }
    feature_library.library_ui -[navigates]-> feature_practice.practice_ui 'launches practice on a curated deck'
    feature_practice.practice_ui -[navigates]-> feature_library.library_ui 'curates related cards into a deck' { #prepared }
    feature_practice.practice_ui -[flows]-> settings.settings_domain 'reads practice-scoped settings (subset)' { #prepared }
    feature_home.home -[navigates]-> feature_practice.practice_ui 'opens a due session (PracticeConfig.DuePractice)'
    feature_home.home -[navigates]-> feature_vocabulary.vocabulary_ui 'resumes / quick capture' { #future }
    feature_home.home -[depends]-> feature_practice.practice_domain 'reads due count + ids via DuePracticeRepository (no library dep)'
    feature_home.home -[depends]-> settings.settings_domain 'reads daily goal via UserSettingsRepository'
  }

  // Actor entry
  learner -[navigates]-> client.shell.primary_navigation 'launches and uses the client' { technology 'UI interaction' }
  client.core.core_runtime -[flows]-> platform_services 'uses platform runtime' { technology 'Platform APIs' }
}

deployment {
  android_target = platform 'Android' {
    description 'Android deployable target: `MainActivity` поднимает общий `shared/app-shell`.'
    technology 'apps/androidApp'
    instanceOf client.shell
  }

  desktop_target = platform 'Desktop JVM' {
    description 'Desktop JVM target (Kotlin/JVM + Compose Desktop).'
    technology 'apps/desktopApp'
    instanceOf client.shell
  }

  ios_target = platform 'iOS' {
    description 'iOS host application линкует фреймворк `SenseeKit` с Compose-based shared UI.'
    technology 'apps/iosApp + apps/iosFramework'
    instanceOf client.shell
  }

  js_target = platform 'Web (JS)' {
    description 'Browser JS target, публикуемый из `apps/webApp`.'
    technology 'apps/webApp:js'
    instanceOf client.shell
  }

  wasm_target = platform 'Web (Wasm)' {
    description 'Browser Wasm target, публикуемый из `apps/webApp`.'
    technology 'apps/webApp:wasmJs'
    instanceOf client.shell
  }
}
