views 'Sensee Client' {

  // C4 Level 1 — System Context
  view index {
    title 'Контекст / Ландшафт клиента'
    description 'Sensee Client как система в окружении: пользователь, platform services, provider APIs и отложенный backend.'
    include learner
    include client
    include platform_services
    include provider_apis
    include future_backend
    autoLayout LeftRight 160 120

    style provider_apis, future_backend {
      color muted
    }
  }

  // C4 Level 2 — Containers
  view containers of client {
    title 'Структура / Контейнеры клиента'
    description 'Продуктовые зависимости клиента: разделы → seam-ы/доменные модели, cross-feature и внешние границы. Хранение — в database_aggregation, сеть/провайдеры — в integration_seams, DI-композиция — в primary_navigation_shell.'
    include *
    include learner
    include provider_apis
    // product-dependency overview — foundations & their plumbing live in dedicated views:
    //   storage -> database_aggregation, network/providers -> integration_seams, DI composition -> primary_navigation_shell
    exclude * -> * where (tag is #prepared or tag is #future)
    exclude client.ui
    exclude client.core
    exclude client.persistence
    // shell shows only "hosts the 5 sections"; DI wiring detail lives in primary_navigation_shell
    exclude client.shell -> *
    include client.shell -> client.feature_home
    include client.shell -> client.feature_practice
    include client.shell -> client.feature_library
    include client.shell -> client.feature_vocabulary
    include client.shell -> client.feature_profile
    // seams read settings internally; keep settings as the Profile-owned domain only
    exclude client.ai -> client.settings
    exclude client.tts -> client.settings
    autoLayout LeftRight 230 150

    style provider_apis {
      color muted
    }
  }

  // Product capabilities
  view capability_map {
    title 'Структура / Продуктовые возможности'
    description 'Capability-first срез: реализованные возможности (capture, card derivation), их данные, хранение (persistence) и внешние provider-зависимости; planned evolution (service sets).'
    include client.feature_vocabulary.vocabulary_ui
    include client.feature_vocabulary.vocabulary_capture
    include client.feature_vocabulary.vocabulary_domain
    include client.feature_library.card_derivation
    include client.feature_library.library_catalog
    include client.feature_library.service_catalog
    include client.lexicon.lexical_model
    include client.lexicon.lexical_data
    include client.ai.ai_seam
    include client.ai.ai_llm
    include client.verification.verification_seam
    include client.feature_practice.practice_ui
    include client.persistence
    include provider_apis
    include future_backend
    autoLayout LeftRight 230 150

    style client.feature_library.service_catalog, provider_apis, future_backend {
      color muted
    }
  }

  // C4 Level 3 — Component views per feature
  view feature_practice of client.feature_practice {
    title 'Компоненты / Practice'
    description 'Practice feature: presentation, domain, data, schema и связи с library catalog, SRS, grammar, speech (TTS) и persistence.'
    include *
    include client.feature_library.library_catalog
    include client.srs.srs_engine
    include client.grammar.grammar_taxonomy
    include client.ui.learning_deck
    include client.tts.tts_seam
    include client.persistence
    // planned cross-feature navigation lives in cross_feature_navigation
    exclude * -> * where (tag is #prepared or tag is #future)
    autoLayout LeftRight 230 150
  }

  view feature_vocabulary of client.feature_vocabulary {
    title 'Компоненты / Vocabulary Editor'
    description 'Vocabulary Editor feature: add-path и подготовленный write workflow, связи с AI, lexicon и persistence; verification подключён к живому capture в двух узких ролях — pre-AI grounding в prompt и post-AI silent фильтр качества примеров.'
    include *
    include client.verification.verification_seam
    include client.ai.ai_seam
    include client.lexicon.lexical_model
    include client.lexicon.lexical_data
    include client.lexicon.sense_serialization
    include client.grammar.grammar_taxonomy
    include client.persistence
    // planned cross-feature navigation lives in cross_feature_navigation
    exclude * -> * where (tag is #prepared or tag is #future)
    autoLayout LeftRight 230 150
  }

  view feature_library of client.feature_library {
    title 'Компоненты / Library'
    description 'Library feature как владелец каталога: catalog data, card derivation projection, schema, planned service sets.'
    include *
    include client.lexicon.lexical_model
    include client.feature_practice.practice_ui
    include client.core.network
    include client.persistence
    include future_backend
    // prepared cross-feature navigation lives in cross_feature_navigation; the future service-set story stays here
    exclude * -> * where tag is #prepared
    autoLayout LeftRight 230 150

    style client.feature_library.service_catalog, future_backend {
      color muted
    }
  }

  // Integration seams
  view integration_seams {
    title 'Структура / Интеграционные seam-ы'
    description 'Внешне-интеграционные seam-ы (AI, TTS, verification): boundary contract + impls + composition, routing по настройкам, кэширование в БД (TTS audio cache, verification L2 cache; AI без кэша) и выходы к provider APIs.'
    include client.ai
    include client.ai.ai_seam
    include client.ai.ai_curated
    include client.ai.ai_llm
    include client.ai.ai_embedding
    include client.tts
    include client.tts.tts_seam
    include client.tts.tts_providers
    include client.tts.tts_playback
    include client.verification
    include client.verification.verification_seam
    include client.verification.verification_curated
    include client.verification.verification_network
    include client.settings.settings_domain
    include client.core.mock_backend
    include client.persistence
    include provider_apis
    autoLayout LeftRight 230 150

    style provider_apis {
      color muted
    }
  }

  // Database aggregation
  view database_aggregation {
    title 'Структура / Агрегация БД'
    description 'Полная картина БД: шесть feature/seam data-модулей пишут в единый `SenseeDatabase` (`shared/database`), который агрегирует их шесть owned-схем; отдельно security-граница secure storage и платформенные SQL-драйверы.'
    include client.persistence
    // writers: data modules / seams that store into the single database
    include client.feature_practice.practice_data
    include client.feature_library.library_catalog
    include client.lexicon.lexical_data
    include client.settings.settings_data
    include client.tts.tts_playback
    include client.verification.verification_seam
    // feature/seam-owned schemas aggregated by shared/database
    include client.feature_practice.practice_schema
    include client.feature_library.library_schema
    include client.lexicon.lexical_schema
    include client.settings.settings_schema
    include client.tts.tts_schema
    include client.verification.verification_schema
    include client.core.secure_storage
    include platform_services
    // keep a clean "writers -> DB -> schemas" flow: drop data->own-schema edges (they live in the feature views) so persistence stays the single hub
    exclude client.feature_practice.practice_data -> client.feature_practice.practice_schema
    exclude client.feature_library.library_catalog -> client.feature_library.library_schema
    exclude client.lexicon.lexical_data -> client.lexicon.lexical_schema
    exclude client.tts.tts_playback -> client.tts.tts_schema
    exclude client.verification.verification_seam -> client.verification.verification_schema
    autoLayout LeftRight 230 150

    style platform_services {
      color muted
    }
  }

  // Primary navigation shell
  view primary_navigation_shell of client {
    title 'Поведение / Базовая навигация'
    description 'Базовая root/primary navigation model: splash, пять постоянных targets и config-driven переходы.'
    include client.shell
    include client.shell.root
    include client.shell.primary_navigation
    include client.shell.splash
    include client.feature_home.home
    include client.feature_practice.practice_ui
    include client.feature_vocabulary.vocabulary_ui
    include client.feature_library.library_ui
    include client.feature_profile.profile_ui
    autoLayout LeftRight 230 150

    style client.feature_home.home {
      border dashed
    }
  }

  // Cross-feature navigation (implemented + planned in one place)
  view cross_feature_navigation {
    title 'Поведение / Межраздельная навигация'
    description 'Единая карта переходов между разделами: реализованная навигация и planned (#prepared/#future) cross-feature пути. Lifecycle-теги на связях проверяются через read-view/find-relationships (query-by-tags их не возвращает).'
    include client.shell.primary_navigation
    include client.feature_home.home
    include client.feature_practice.practice_ui
    include client.feature_vocabulary.vocabulary_ui
    include client.feature_library.library_ui
    include client.feature_profile.profile_ui
    include client.feature_library.service_catalog
    include future_backend
    autoLayout LeftRight 230 150

    style client.feature_home.home, client.feature_library.service_catalog, future_backend {
      color muted
    }
  }

  // Deployment
  deployment view deployment {
    title 'Развёртывание / Платформенные артефакты'
    description 'Пять deployable targets, каждый из которых поднимает общий `shared/app-shell`.'
    include *
    autoLayout LeftRight 230 150
  }

  // Runtime flows (dynamic)
  dynamic view startup_flow {
    title 'Поведение / Запуск приложения'
    description 'Запуск приложения: app-scoped preload runtime-таксономии, cold-start splash либо тёплое восстановление deep-target, открытие PrimaryShellComponent.'

    learner -> client.shell.root 'запускает приложение, создаётся PlatformEnvironment и вызывается createAppRoot(...)'
    client.shell.root -> client.core.core_runtime 'поднимает AppGraph и RootComponent; app-scoped запускает PreloadAppStartupUseCase'
    client.shell.root -> client.shell.splash 'cold start: splash, пока StartupComponent ждёт preload'
    client.shell.splash -> client.grammar.grammar_taxonomy 'ждёт preload runtime-таксономии (labels + invariants)'
    client.shell.splash -> client.shell.primary_navigation 'StartupState.Loaded открывает PrimaryShellComponent; сбой остаётся retryable'
    client.shell.root -> client.shell.primary_navigation 'тёплый старт: восстановленный deep-target без splash'
    client.shell.primary_navigation -> client.feature_home.home 'показывает стартовый Home target'
  }

  dynamic view deck_interaction_flow {
    title 'Поведение / Practice deck'
    description 'Текущее интерактивное поведение practice deck через fixture-backed data flow, database и SRS orchestration.'

    learner -> client.feature_practice.practice_ui 'открывает practice deck screen'
    client.feature_practice.practice_ui -> client.feature_library.library_catalog 'запрашивает deck через CatalogRepository'
    client.feature_library.library_catalog -> client.core.network 'загружает fixture-backed каталог/колоды через HttpClient'
    client.core.mock_backend -> client.core.network 'обслуживает запрос через Ktor MockEngine'
    client.feature_library.library_catalog -> client.persistence 'сохраняет deck/membership state локально (флаг subscribed)'
    client.feature_library.library_catalog -> client.feature_practice.practice_ui 'возвращает разделённые карточки и состояние загрузки'
    client.feature_practice.practice_ui -> client.ui.learning_deck 'передаёт карточки и локальный LearningDeckState'
    client.feature_practice.practice_ui -> client.tts.tts_seam 'по запросу озвучивает карточку через Speaker'
    learner -> client.ui.learning_deck 'тапает, свайпает, использует кнопки и клавиатуру'
    client.ui.learning_deck -> client.feature_practice.practice_ui 'возвращает swipe callbacks и ведёт историю undo'
    client.feature_practice.practice_ui -> client.feature_practice.practice_domain 'отправляет review result через PracticeReviewRepository'
    client.feature_practice.practice_data -> client.srs.srs_engine 'пересчитывает SRS-состояние'
    client.feature_practice.practice_ui -> client.ui.learning_deck 'обновляет текущую карточку и состояние колоды'
  }

  dynamic view vocabulary_capture_flow {
    title 'Поведение / Захват слова'
    description 'Реализованный основной продуктовый сценарий: ввод → pre-AI grounding в prompt → curated/LLM enrichment → набор Sense → post-AI silent фильтр качества примеров → мультивыбор + ручной смысл → подтверждение → durable persist (+ best-effort embedding) → captured catalog projection. Verification подключён к живому capture в двух узких ролях.'

    learner -> client.shell.primary_navigation 'нажимает кнопку Vocabulary Editor (add-path)'
    client.shell.primary_navigation -> client.feature_vocabulary.vocabulary_ui 'открывает QuickCapture'
    learner -> client.feature_vocabulary.vocabulary_ui 'вводит слово/фразу (кандидаты держатся в памяти, в store ничего не пишется)'
    client.feature_vocabulary.vocabulary_ui -> client.verification.verification_seam 'pre-AI: зовёт verifier, строит EnrichmentGrounding (фильтр usableAsLlmContext) для prompt'
    client.feature_vocabulary.vocabulary_ui -> client.ai.ai_seam 'запрашивает enrichment через AI-границу с grounding в EnrichmentRequest'
    client.ai.ai_seam -> client.ai.ai_curated 'сначала проверяет curated enrichment (backend HTTP); hit short-circuits LLM'
    client.ai.ai_seam -> client.ai.ai_llm 'при miss и настроенном ключе маршрутизирует в LLM adapter'
    client.ai.ai_llm -> provider_apis 'вызывает provider API'
    client.feature_vocabulary.vocabulary_ui -> client.lexicon.lexical_model 'маппер vocabulary-домена приводит ответ к Sense, editor оборачивает в CaptureSense'
    client.feature_vocabulary.vocabulary_ui -> client.verification.verification_seam 'post-AI: silent ExampleQualityChecker отсеивает слабые примеры (≥1 пример остаётся)'
    learner -> client.feature_vocabulary.vocabulary_ui 'мультивыбор смыслов и/или ручной смысл (опц. «дополнить ассистентом»)'
    client.feature_vocabulary.vocabulary_ui -> client.feature_vocabulary.vocabulary_capture 'выбор и есть подтверждение → SenseStatus.Confirmed'
    client.feature_vocabulary.vocabulary_capture -> client.lexicon.lexical_data 'сохраняет подтверждённые Sense (SenseWriteRepository)'
    client.lexicon.lexical_data -> client.persistence 'durable в таблицу sense'
    client.lexicon.lexical_data -> client.ai.ai_embedding 'после коммита: best-effort embedding (EmbeddingPort → AiEmbeddingClient, свой путь)'
    client.ai.ai_embedding -> provider_apis 'вызывает /v1/embeddings; вектор в sense_embedding (сбой/офлайн не блокируют save)'
    client.lexicon.lexical_model -> client.feature_library.card_derivation 'проецирует Confirmed Personal смыслы в captured deck (SenseCatalogProjection): группировка по lemma_key и form cards'
  }

  dynamic view card_derivation_flow {
    title 'Поведение / Деривация карточек'
    description 'Реализованная projection-логика: Confirmed Personal смыслы проецируются в captured deck, sibling grouping по lemma_key и form-variant cards (id sense_id:form:slot) для irregular verbs. Planned остаётся UI-навигация по family/detail.'

    learner -> client.feature_vocabulary.vocabulary_ui 'подтверждает lexical material'
    client.feature_vocabulary.vocabulary_ui -> client.feature_vocabulary.vocabulary_capture 'завершает authoring flow'
    client.feature_vocabulary.vocabulary_capture -> client.lexicon.lexical_data 'сохраняет confirmed Sense (SenseWriteRepository)'
    client.lexicon.lexical_model -> client.feature_library.card_derivation 'запускает derivation of learning cards'
    client.feature_library.card_derivation -> client.feature_library.library_catalog 'captured deck попадает в catalog projection'
    client.feature_library.library_catalog -> client.persistence 'сохраняет deck/membership state (контент Sense — в таблице sense)'
  }

  dynamic view planned_library_curation_flow {
    title 'Планируемое / Курирование Library'
    description 'Планируемое поведение Library как владельца каталога: браузер записей/карточек, правка/удаление своей карточки, курирование колод, сервисные наборы и запуск practice.'

    learner -> client.feature_library.library_ui 'открывает Library, смотрит записи/карточки со статусами'
    client.feature_library.library_ui -> client.lexicon.lexical_model 'читает собственный каталог смыслов и колод'
    learner -> client.feature_library.library_ui 'правит или удаляет свою карточку'
    client.feature_library.library_ui -> client.feature_vocabulary.vocabulary_ui 'deep-link на edit-path соответствующей lemma_key-группы (EB-7)'
    learner -> client.feature_library.library_ui 'открывает сервисные наборы'
    client.feature_library.library_ui -> client.feature_library.service_catalog 'запрашивает список сервисных наборов'
    client.feature_library.service_catalog -> future_backend 'загружает curated sets'
    client.feature_library.service_catalog -> client.feature_library.library_catalog 'подписка целиком или claim части в собственный каталог'
    learner -> client.feature_library.library_ui 'запускает practice по курируемой колоде'
    client.feature_library.library_ui -> client.feature_practice.practice_ui 'открывает PracticeConfig.DeckPractice (read-only consumer)'
  }
}
