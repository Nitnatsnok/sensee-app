specification {
  // Element kinds (logical model)

  element actor {
    notation 'Пользователь'
    style {
      shape person
      color green
    }
  }

  element client_app {
    notation 'Клиентское приложение'
    style {
      color primary
      border solid
    }
  }

  element container {
    notation 'Контейнер (группа модулей)'
    style {
      color blue
    }
  }

  element component {
    notation 'Компонент (модуль)'
    style {
      shape component
      color sky
    }
  }

  element capability {
    notation 'Продуктовая возможность'
    style {
      color indigo
    }
  }

  element store {
    notation 'Локальное хранилище'
    style {
      shape cylinder
      color amber
    }
  }

  element external_system {
    notation 'Внешняя система'
    style {
      color muted
    }
  }

  // Deployment node kinds (deployment model)

  deploymentNode platform {
    notation 'Платформенный артефакт'
    style {
      color slate
    }
  }

  // Relationship kinds
  // depends   — статическая зависимость/wiring (compile-time, DI)
  // flows     — поток данных/управления во время выполнения
  // navigates — пользовательская навигация между разделами

  relationship depends {
    line solid
  }

  relationship flows {
    color sky
    line dashed
  }

  relationship navigates {
    color slate
    line dotted
  }

  // Tags (lifecycle state)

  tag prepared {
    color #F59E0B
  }

  tag future {
    color #64748B
  }
}
