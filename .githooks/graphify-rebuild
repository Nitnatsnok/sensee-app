#!/bin/sh
# Rebuild the committed graphify knowledge graph from the staged changes and
# stage it, so the graph in this commit matches the code.
#
# The graph (graphify-out/graph.json, GRAPH_REPORT.md) is tracked, so it travels
# with the branch — checkout/merge restore the matching graph and need no hook.
#
# AST-only: no network, no LLM, no API cost. Incremental: only staged changed
# files are re-extracted, and deleted paths are evicted by graphify. Uses the
# fast working-tree path unless the same file has both staged and unstaged
# changes; only then it falls back to a temporary staged-index checkout. Runs in
# pre-commit but NEVER blocks — any failure exits 0 so a graph problem cannot
# stop a commit.
#
# Opt out with GRAPHIFY_SKIP=1.
set -u

[ "${GRAPHIFY_SKIP:-0}" = "1" ] && exit 0
command -v graphify >/dev/null 2>&1 || exit 0

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$repo_root" || exit 0

# Skip during rebase/merge/cherry-pick: that index churn is not a normal commit.
git_dir=$(git rev-parse --git-dir 2>/dev/null) || exit 0
[ -d "$git_dir/rebase-merge" ] && exit 0
[ -d "$git_dir/rebase-apply" ] && exit 0
[ -f "$git_dir/MERGE_HEAD" ] && exit 0
[ -f "$git_dir/CHERRY_PICK_HEAD" ] && exit 0

# Staged files. Skip when only the graph artifacts changed — nothing to rebuild,
# and it avoids a rebuild loop.
changed=$(git diff --cached --name-only --diff-filter=ACMRD)
non_graph=$(printf '%s\n' "$changed" | grep -v '^graphify-out/' | grep -v '^[[:space:]]*$' || true)
[ -z "$non_graph" ] && exit 0

# Resolve a Python that can import graphify (the CLI wrapper cannot run modules,
# and on uv/pipx installs the system python often lacks graphify).
graphify_python=""
try_python() {
    cand=$(printf '%s' "$1" | tr '\\' '/')
    [ -n "$cand" ] || return 1
    "$cand" -c "import graphify" 2>/dev/null || return 1
    graphify_python="$cand"
    return 0
}
# 1. Interpreter saved by the /graphify skill (local, known to have graphify).
[ -f graphify-out/.graphify_python ] && try_python "$(cat graphify-out/.graphify_python 2>/dev/null)"
# 2. uv tool install location.
if [ -z "$graphify_python" ] && command -v uv >/dev/null 2>&1; then
    uvdir=$(uv tool dir 2>/dev/null | tr '\\' '/')
    try_python "$uvdir/graphifyy/Scripts/python.exe" \
        || try_python "$uvdir/graphifyy/bin/python"
fi
# 3. System python.
[ -z "$graphify_python" ] && { try_python python3 || try_python python; }
[ -z "$graphify_python" ] && exit 0

# PYTHONHASHSEED pins louvain clustering so the graph does not churn run-to-run.
export PYTHONHASHSEED=0

watch_path="."
snapshot_dir=""

# Fast path: when the staged files do not also have unstaged edits, the working
# tree matches the commit for those paths and graphify can use its normal
# changed_paths incremental rebuild. Fall back to a staged-index snapshot only
# for partial staging.
unstaged=$(git diff --name-only --diff-filter=ACMRD)
if [ -n "$unstaged" ]; then
    partial_overlap=$(printf '%s\n%s\n' "$changed" "$unstaged" | sort | uniq -d | grep -v '^graphify-out/' || true)
    if [ -n "$partial_overlap" ]; then
        snapshot_dir=$(mktemp -d "${TMPDIR:-/tmp}/sensee-graphify-index.XXXXXX") || exit 0
        trap 'rm -rf "$snapshot_dir"' EXIT HUP INT TERM
        git checkout-index -a --prefix="$snapshot_dir/" >/dev/null 2>&1 || exit 0
        watch_path="$snapshot_dir"
    fi
fi

GRAPHIFY_CHANGED="$changed" "$graphify_python" - "$watch_path" <<'PY' >/dev/null 2>&1 || exit 0
import os
import sys
from pathlib import Path

watch_path = Path(sys.argv[1])
changed = [
    Path(p)
    for p in os.environ.get("GRAPHIFY_CHANGED", "").splitlines()
    if p.strip() and not p.startswith("graphify-out/")
]
if not changed:
    raise SystemExit(0)

from graphify.watch import _rebuild_code

ok = _rebuild_code(watch_path, changed_paths=changed, block_on_lock=True)
raise SystemExit(0 if ok else 1)
PY

if [ -n "$snapshot_dir" ]; then
    if [ -f "$snapshot_dir/graphify-out/graph.json" ] && [ -f "$snapshot_dir/graphify-out/GRAPH_REPORT.md" ]; then
        mkdir -p "$repo_root/graphify-out" || exit 0
        cp "$snapshot_dir/graphify-out/graph.json" "$repo_root/graphify-out/graph.json" 2>/dev/null || exit 0
        cp "$snapshot_dir/graphify-out/GRAPH_REPORT.md" "$repo_root/graphify-out/GRAPH_REPORT.md" 2>/dev/null || exit 0
    fi
fi

git add graphify-out/graph.json graphify-out/GRAPH_REPORT.md 2>/dev/null || true
exit 0
