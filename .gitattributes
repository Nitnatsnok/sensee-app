#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Normalize all text files to LF in the repository and the working tree on
# every OS, regardless of the contributor's core.autocrlf setting.
* text=auto eol=lf

# Windows script files must stay CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Unix scripts and the Gradle wrapper must stay LF.
*.sh    text eol=lf
gradlew text eol=lf

# Binary files must be left untouched.
*.jar   binary
*.png   binary
*.webp  binary
*.ico   binary
*.db    binary

# graphify knowledge graph: union-merge so parallel branches never leave
# conflict markers in the generated graph. The merge driver is configured
# locally by scripts/setup-git-hooks.sh (merge.graphify.driver). `-text` skips
# EOL normalization; `-diff` keeps git from rendering a ~10 MB textual diff.
graphify-out/graph.json merge=graphify -text -diff
